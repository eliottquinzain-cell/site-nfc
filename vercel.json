{
  "version": 2,
  "rewrites": [
    { "source": "/.netlify/functions/api", "destination": "/api/index.js" },
    { "source": "/.netlify/functions/:match*", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" }
  ]
}
